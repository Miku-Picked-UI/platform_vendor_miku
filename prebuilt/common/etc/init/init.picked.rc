# Custom emoji font picked in Settings > Miku-Picked > Emoji style. system_server copies it
# here at boot (FontManagerService); the directory is labeled font_data_file so every app can
# read the font, like updatable system fonts.
on post-fs-data
    mkdir /data/fonts/picked 0771 system system

# Boot animation imported in Settings > Picked features > Style > Boot animation. Settings
# (system uid) writes bootanimation.zip here; bootanimation (graphics uid) only reads it.
on post-fs-data
    mkdir /data/misc/picked_bootanim 0755 system system

# Ad blocker (Settings > Picked features > Ad blocker): Settings writes the merged hosts file
# here, in place, and init lays it over /system/etc/hosts, which the DNS resolver reads before
# asking any DNS server (also with Private DNS on). Switching it off unmounts it again.
on post-fs-data
    mkdir /data/misc/picked_adblock 0755 system system

on property:persist.sys.picked.adblock=1
    mount none /data/misc/picked_adblock/hosts /system/etc/hosts bind

on property:persist.sys.picked.adblock=0
    umount /system/etc/hosts
