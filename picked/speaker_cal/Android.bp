//
// Speaker Calibrator: measures a speaker with the phone's microphone(s) and writes an AxionFx
// preset for a chosen sound style (the tone in the Equalizer app's bands, a sub cut in the FIR
// EQ). Plain SDK app; build-apk.sh builds the same sources outside the tree.

android_app {
    name: "PickedSpeakerCal",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    sdk_version: "current",
    product_specific: true,
}
