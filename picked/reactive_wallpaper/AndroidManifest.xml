<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mikupicked.reactivewallpaper">

    <uses-feature android:name="android.software.live_wallpaper" android:required="true" />

    <application
        android:label="@string/app_name"
        android:directBootAware="true"
        android:defaultToDeviceProtectedStorage="true"
        android:allowBackup="false">

        <service
            android:name=".ReactiveWallpaperService"
            android:label="@string/app_name"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/reactive_wallpaper" />
        </service>

        <activity
            android:name=".SettingsActivity"
            android:label="@string/settings_title"
            android:theme="@android:style/Theme.DeviceDefault.Settings"
            android:exported="true" />

        <!-- Settings > Picked features opens this: it hands the live-wallpaper preview a real
             ComponentName extra, which a preference XML intent cannot. -->
        <activity
            android:name=".SetWallpaperActivity"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:exported="true" />
    </application>
</manifest>
