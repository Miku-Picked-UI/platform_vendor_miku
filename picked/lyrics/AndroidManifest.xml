<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mikupicked.lyrics">

    <!-- The active media session (track, position, controls) of any player -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />
    <!-- Synced lyrics from lrclib.net -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/lyrics_name"
        android:icon="@drawable/ic_lyrics"
        android:allowBackup="false">

        <!-- Started by SystemUI (Now Bar), also over the lock screen -->
        <activity
            android:name=".LyricsActivity"
            android:exported="true"
            android:permission="android.permission.STATUS_BAR_SERVICE"
            android:showWhenLocked="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.mikupicked.lyrics"
            android:theme="@style/LyricsTheme"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="com.mikupicked.lyrics.SHOW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
